# Spendetector secrets. Copy to `.env` for local dev; in the cloud these live in the
# Modal secret `spendetector-secrets`. NEVER commit real values. No hardcoding anywhere else.

# --- Telegram (a fresh dedicated bot via BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
TELEGRAM_ALLOWED_CHAT_ID=your-numeric-telegram-chat-id

# --- OpenAI (the org/project MUST have data retention + training opt-out ON) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-2024-08-06   # optional override; default is full GPT-4o (never mini)

# --- Notion (an internal integration shared with the Spendetector page) ---
NOTION_TOKEN=ntn_...
# The page you shared with the integration; only needed once, to run setup_notion.py.
SPENDETECTOR_PARENT_PAGE_ID=
# Filled in by `python -m spendetector.setup_notion`:
SPENDETECTOR_RECEIPTS_DB_ID=
SPENDETECTOR_ITEMS_DB_ID=
NOTION_DASHBOARD_URL=https://www.notion.so/your-spendetector-dashboard
